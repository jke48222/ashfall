# ASHFALL — credentials template.
# Copy to `.env` (gitignored) and fill in real values. Format: `key: value`.
# The loader (tools/env.py) matches keys by substring, so the human-readable
# labels below are fine. PolyHaven needs no key (public API).

tunee.ai api key: <TUNEE_AI_KEY>
elevenlabs api key: <ELEVENLABS_KEY>
hugging face access token: <HF_TOKEN>
modelslab api key: <MODELSLAB_KEY>
epic games login: <EPIC_EMAIL>
adobe login: <ADOBE_EMAIL>
sketchfab api key: <SKETCHFAB_TOKEN>
meshy.ai api key: <MESHY_KEY>
freesound client id: <FREESOUND_CLIENT_ID>
freesound api key/client secret: <FREESOUND_CLIENT_SECRET>
