# ============================================================================
#  ASHFALL — .gitignore  (Unreal Engine 5.8 project)
# ============================================================================

# ---- Secrets (NEVER commit) ------------------------------------------------
.env
*.env
!.env.example

# ---- Unreal Engine generated / regenerable ---------------------------------
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Build/
*.VC.db
*.opensdf
*.opendb
*.sdf
*.sln
*.suo

# ---- IDE project files (regenerated by UBT) --------------------------------
*.xcodeproj/
*.xcworkspace/
*.code-workspace
.vs/
.vscode/
.idea/

# ---- OS / agent local config -----------------------------------------------
.DS_Store
.claude/

# ---- Third-party plugins (installed externally — see README "Required
#      external plugins". VibeUE ships its own git repo and FAB distribution
#      and is Win64-only, so it is not vendored here.) -----------------------
Plugins/VibeUE/

# ---- Asset pipeline raw downloads (large, regenerable staging area) --------
Tools/Incoming/

# ---- Python ----------------------------------------------------------------
__pycache__/
*.pyc
.venv/
venv/
